NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
BOT_SECRET=a-shared-secret-between-bot-and-web

# Optional: comma-separated list of allowed emails. If set, only these emails can sign up and access the app.
# Leave empty to allow all (useful for development).
# ALLOWED_EMAILS=user1@example.com,user2@example.com

# Optional: set to "true" to log Realtime connection/subscription details in the browser console (for debugging).
# NEXT_PUBLIC_DEBUG_REALTIME=true
