{
  "name": "taskforge",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @taskforge/web dev",
    "dev:bot": "pnpm --filter @taskforge/bot dev",
    "build": "pnpm --filter @taskforge/shared build && pnpm --filter @taskforge/web build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.1.0"
}
